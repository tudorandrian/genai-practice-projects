# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
# Secrets and local tooling
.env
.claude/
.superpowers/
.vscode/
.idea/
# Generated artefacts: everything under any output/ except the two proof files
projects/*/output/*
!projects/*/output/.gitkeep
!projects/*/output/metrics.txt
!projects/*/output/*_session.txt
!projects/*/output/session.txt
!projects/*/output/curl_demo.txt
!projects/*/output/captions.txt
!projects/*/output/transcript.txt
!projects/*/output/summary.txt
!projects/*/output/conversation_transcript.txt
/output/
# Data caches and indexes are never tracked
.cache/
projects/*/data/cache/
projects/*/chroma_index/
projects/*/index/
projects/*/test-images/
projects/*/data/*.wav
# P11's synthetic corpus is generated by synthetic_docs.write_all(); never tracked
projects/p11_rag_chatbot/data/*
!projects/p11_rag_chatbot/data/.gitkeep
*.joblib
*.pkl
*.pt
*.pth
*.bin
*.sqlite3
*.h5
*.keras
*.ipynb
