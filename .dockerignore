# .git is kept on purpose: core tests call `git ls-files`.
# Every top-level dot entry stays out of the image (editor, tool and cache state),
# except the tracked ones the build and the tests need.
.*
!.git
!.github
!.gitattributes
!.gitignore
!.gitleaks.toml
!.pre-commit-config.yaml
!.python-version
!.env.example
!.dockerignore
__pycache__/
*.pyc
htmlcov/
/output/
projects/*/chroma_index/
projects/*/data/cache/
**/*.wav
projects/*/output/runs/
projects/*/index/
projects/*/test-images/
projects/p11_rag_chatbot/data/*
!projects/p11_rag_chatbot/data/.gitkeep
