# Nothing loads .env automatically: export these variables, or copy this file to .env (gitignored)
# and run with `uv run --env-file .env ...`. Every key is optional; the projects fall back to
# local or stub providers.
OPENAI_API_KEY=
MEETING_LLM_PROVIDER=ollama
MEETING_OLLAMA_MODEL=qwen2.5:1.5b
MEETING_OLLAMA_URL=http://localhost:11434
MEETING_OPENAI_MODEL=gpt-4o-mini
MEETING_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
RAG_LLM_PROVIDER=ollama
RAG_OLLAMA_MODEL=qwen2.5:1.5b
RAG_OLLAMA_URL=http://localhost:11434
RAG_OPENAI_MODEL=gpt-4o-mini
TUTOR_LLM_PROVIDER=ollama
TUTOR_OLLAMA_MODEL=qwen2.5:1.5b
TUTOR_OLLAMA_URL=http://localhost:11434
TUTOR_OPENAI_MODEL=gpt-4o-mini
GENAI_DATA_DIR=
# `docker compose --profile llm` and the `llm`-marked tests (docker compose reads .env itself).
# OLLAMA_DATA: a directory with models already pulled, instead of the `ollama` volume.
# REQUIRE_OLLAMA=1 makes the `llm` tests fail, not skip, when Ollama is not reachable.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_DATA=
REQUIRE_OLLAMA=
